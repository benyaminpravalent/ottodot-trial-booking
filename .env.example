# Local Docker Postgres (docker compose up -d creates both databases)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ottodot?sslmode=disable
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/ottodot_test?sslmode=disable

# Supabase: paste the "Connection string" (URI, session mode) from Project Settings -> Database.
# Nothing else changes.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# HTTP port for `go run ./cmd/server`
PORT=3000
